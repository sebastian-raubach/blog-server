<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<configuration xmlns="http://www.jooq.org/xsd/jooq-codegen-3.11.0.xsd">
	<!-- Configure the database connection here -->
	<generator>
		<generate>
			<pojos>true</pojos>
			<globalCatalogReferences>false</globalCatalogReferences>
			<globalKeyReferences>false</globalKeyReferences>
			<globalLinkReferences>false</globalLinkReferences>>
			<globalQueueReferences>false</globalQueueReferences>
			<globalRoutineReferences>false</globalRoutineReferences>
			<globalSchemaReferences>false</globalSchemaReferences>
			<globalSequenceReferences>false</globalSequenceReferences>
			<globalTableReferences>false</globalTableReferences>
			<globalUDTReferences>false</globalUDTReferences>
			<javaTimeTypes>false</javaTimeTypes>
		</generate>

		<database>
			<excludes>
			</excludes>
			<includes>.*</includes>
			<inputSchema>blog</inputSchema>
			<outputSchema>blog_db</outputSchema>
			<name>org.jooq.meta.mysql.MySQLDatabase</name>

			<forcedTypes>
				<forcedType>
					<expression>.*</expression>
					<name>BOOLEAN</name>
					<types>.*tinyint.*</types>
				</forcedType>
				<forcedType>
					<userType>blog.raubach.database.codegen.enums.SitesSitetype</userType>
					<enumConverter>true</enumConverter>
					<includeTypes>.*</includeTypes>
					<includeExpression>(?i:view_sites\.sitetype)</includeExpression>
				</forcedType>
<!--				<forcedType>-->
<!--					<userType>blog.raubach.database.codegen.enums.PostsitesGroundtype[]</userType>-->
<!--					<includeTypes>.*</includeTypes>-->
<!--					<includeExpression>(?i:view_sites\.groundtypes)</includeExpression>-->
<!--					&lt;!&ndash; Automatically creates a JSONJacksonConverter for the userType &ndash;&gt;-->
<!--					<jsonConverter>true</jsonConverter>-->
<!--				</forcedType>-->
				<forcedType>
					<userType>blog.raubach.database.codegen.enums.PostsType</userType>
					<enumConverter>true</enumConverter>
					<includeTypes>.*</includeTypes>
					<includeExpression>(?i:view_posts\.post_type)</includeExpression>
				</forcedType>
				<forcedType>
					<userType>blog.raubach.database.codegen.enums.HillsType</userType>
					<enumConverter>true</enumConverter>
					<includeTypes>.*</includeTypes>
					<includeExpression>(?i:view_hills\.hill_type)</includeExpression>
				</forcedType>
				<forcedType>
					<binding>blog.raubach.database.binding.IntArrayBinding</binding>
					<expression>.*(view_).*\..*(_ids).*</expression>
					<types>.*json.*</types>
					<userType>Integer[]</userType>
				</forcedType>
				<forcedType>
					<binding>blog.raubach.database.binding.GrountypeArrayBinding</binding>
					<expression>.*(view_sites).*\..*(groundtypes).*</expression>
					<types>.*json.*</types>
					<userType>blog.raubach.database.codegen.enums.PostsitesGroundtype[]</userType>
				</forcedType>
				<forcedType>
					<binding>blog.raubach.database.binding.SiteRatingBinding</binding>
					<expression>.*(sites)\.(rating)</expression>
					<types>.*json.*</types>
					<userType>blog.raubach.pojo.SiteRating</userType>
				</forcedType>
				<forcedType>
					<binding>blog.raubach.database.binding.SiteFacilitiesBinding</binding>
					<expression>.*(sites)\.(facilities)</expression>
					<types>.*json.*</types>
					<userType>blog.raubach.pojo.SiteFacilities</userType>
				</forcedType>
				<forcedType>
					<binding>blog.raubach.database.binding.SiteGroundTypeBinding</binding>
					<expression>.*(view_sites)\.(groundtype)</expression>
					<types>.*enum.*</types>
					<userType>blog.raubach.database.codegen.enums.PostsitesGroundtype</userType>
				</forcedType>
				<forcedType>
					<binding>blog.raubach.database.binding.PostImageArrayBinding</binding>
					<expression>.*(view_posts)\.(images)</expression>
					<types>.*json.*</types>
					<userType>blog.raubach.pojo.view.PostImage[]</userType>
				</forcedType>
				<forcedType>
					<binding>blog.raubach.database.binding.PostHillArrayBinding</binding>
					<expression>.*(view_posts)\.(hills)</expression>
					<types>.*json.*</types>
					<userType>blog.raubach.pojo.view.PostHill[]</userType>
				</forcedType>
				<forcedType>
					<binding>blog.raubach.database.binding.PostSiteArrayBinding</binding>
					<expression>.*(view_posts)\.(sites)</expression>
					<types>.*json.*</types>
					<userType>blog.raubach.pojo.view.PostSite[]</userType>
				</forcedType>
				<forcedType>
					<binding>blog.raubach.database.binding.PostPersonArrayBinding</binding>
					<expression>.*(view_posts|view_hills)\.(people)</expression>
					<types>.*json.*</types>
					<userType>blog.raubach.pojo.view.PostPerson[]</userType>
				</forcedType>
				<forcedType>
					<binding>blog.raubach.database.binding.MiniPostArrayBinding</binding>
					<expression>.*(view_hills|view_stories)\.(posts)</expression>
					<types>.*json.*</types>
					<userType>blog.raubach.pojo.MiniPost[]</userType>
				</forcedType>
				<forcedType>
					<binding>blog.raubach.database.binding.HikeStatsBinding</binding>
					<expression>.*(view_posts)\.(hikeStats)</expression>
					<types>.*json.*</types>
					<userType>blog.raubach.pojo.view.HikeStats</userType>
				</forcedType>
				<forcedType>
					<binding>blog.raubach.database.binding.HikeRatingBinding</binding>
					<expression>.*(view_posts)\.(hikeRating)</expression>
					<types>.*json.*</types>
					<userType>blog.raubach.pojo.view.HikeRating</userType>
				</forcedType>
				<forcedType>
					<binding>blog.raubach.database.binding.StringArrayBinding</binding>
					<expression>.*(view_posts).*\.*(videos).*</expression>
					<types>.*json.*</types>
					<userType>String[]</userType>
				</forcedType>
			</forcedTypes>
		</database>

		<name>blog.raubach.database.CustomCodegen</name>

		<target>
			<directory>src/main/java/</directory>
			<packageName>blog.raubach.database.codegen</packageName>
		</target>
	</generator>

	<jdbc>
		<driver>com.mysql.cj.jdbc.Driver</driver>
		<password></password>
		<properties>
			<property>
				<key>user</key>
				<value>root</value>
			</property>
			<property>
				<key>password</key>
				<value></value>
			</property>
		</properties>
		<url>jdbc:mysql://localhost/blog?serverTimezone=UTC</url>

		<!-- You can also pass user/password and other JDBC properties in the optional properties tag: -->
		<user>root</user>
	</jdbc>
</configuration>